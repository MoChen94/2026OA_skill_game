# ===== OA协同办公平台 .gitignore =====

# Python 虚拟环境（与本机路径绑定，每台电脑需用 安装环境.bat 重建）
.venv/
venv/
backend/.venv/

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/

# 运行数据（数据库含账号信息、上传的文件、备份——绝不入库！
# 新电脑首次启动自动重建演示数据）
data/

# 桌面助手构建产物与本地登录配置（OA助手.ini 含密码，绝对不能上传！）
notifier/dist/
notifier/build/
*.spec
OA助手.ini
notifier/OA助手.ini

# 日志与临时文件
*.log
nul
_*.py

# 测试截图
gui-test-screenshots/

# 编辑器 / 系统文件
.vscode/
.idea/
Thumbs.db
Desktop.ini
